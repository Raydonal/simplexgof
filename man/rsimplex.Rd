\name{rsimplex}
\alias{rsimplex}
\title{Generate Random Observations from the Simplex Distribution}
\description{
  Generates \eqn{n} independent observations from the simplex
  distribution \eqn{S^-(\mu, \sigma^2)} using the representation
  via inverse-Gaussian and chi-squared random variables
  (Michael, Schucany and Haas, 1976).
}
\usage{
rsimplex(n, mu, sigma2)
}
\arguments{
  \item{n}{Positive integer; number of observations to generate.}
  \item{mu}{Numeric scalar or vector of length \eqn{n}; mean
    parameter(s), strictly in \eqn{(0, 1)}.}
  \item{sigma2}{Numeric scalar or vector of length \eqn{n}; dispersion
    parameter(s), strictly positive.
    Larger values yield more spread in the distribution.}
}
\details{
  The algorithm uses the reparametrisation
  \eqn{\epsilon = \mu/(1-\mu)} (odds) and
  \eqn{\tau = \sigma^2(1-\mu)^2}.
  An inverse-Gaussian variate with mean \eqn{\epsilon} and shape
  \eqn{\lambda = 1/\tau} is generated by the Michael--Schucany--Haas
  method; a chi-squared mixture step then places the draw in
  \eqn{(0,1)}.  The algorithm is identical to the one used in the
  reference Ox implementation of Ospina et al. (2026).
}
\value{
  Numeric vector of length \eqn{n} with all values in \eqn{(0, 1)}.
}
\references{
  Barndorff-Nielsen O.E., Jørgensen B. (1991).
  Some parametric models on the simplex.
  \emph{Journal of Multivariate Analysis}, 39(1), 106--116.

  Michael J.R., Schucany W.R., Haas R.W. (1976).
  Generating random variates using transformations with multiple roots.
  \emph{The American Statistician}, 30(2), 88--90.

  Ospina R., Espinheira P.L., Silva F.C., Barros M. (2026).
  A Bootstrap-Calibrated Local Influence Goodness-of-Fit Procedure
  for Simplex Regression Models.
}
\seealso{
  \code{\link{simplex_fit}}, \code{\link{simplex_gof}}
}
\examples{
set.seed(1)

## Scalar mu and sigma2
y <- rsimplex(200, mu = 0.3, sigma2 = 2)
hist(y, breaks = 25, main = "Simplex(0.3, 2)",
     xlab = "y", col = "lightblue")

## Verify empirical mean is close to mu = 0.3
cat("Empirical mean:", round(mean(y), 3), "(true: 0.3)\n")

## Vector inputs (heteroscedastic simulation)
n  <- 100
mu <- seq(0.1, 0.9, length.out = n)
s2 <- rep(1, n)
y2 <- rsimplex(n, mu, s2)
plot(mu, y2, xlab = "True mean", ylab = "Simulated value",
     pch = 19, col = "steelblue")
abline(0, 1, lty = 2)
}
\keyword{distribution}
